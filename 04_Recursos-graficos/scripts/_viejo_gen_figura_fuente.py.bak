# ── medición ───────────────────────────────────────────────────────────────
def angulo_veta(png: Path):
    """Inclinación dominante de la figura, por PCA sobre la tinta.

    Sirve de control de la GEOMETRÍA cuando lo que hay que conservar no es una
    proporción sino un ángulo: si el modelo endereza o tumba la veta, el número
    lo caza. Se descarta la franja superior porque ahí está la línea horizontal
    del terreno, que arrastraría el eje hacia los 0°.
    """
    a = np.array(Image.open(png).convert("L")).astype(int)
    h, w = a.shape
    sub = a[int(h * 0.18):int(h * 0.92), int(w * 0.04):int(w * 0.96)]
    m = sub < 150
    if m.sum() < 200:
        return None
    ys, xs = np.where(m)
    x = xs - xs.mean()
    y = (sub.shape[0] - ys) - (sub.shape[0] - ys).mean()
    vals, vecs = np.linalg.eigh(np.cov(np.vstack([x, y])))
    d = vecs[:, int(np.argmax(vals))]
    return dict(asp=float(np.degrees(np.arctan2(d[1], d[0])) % 180))



def contorno_labor(png: Path):
    """Aísla el contorno de la excavación: lo oscuro que NO es rojo.

    El rojo son las cotas, y las cotas caen fuera de la labor: si entraran en la
    medida, mover una flecha cambiaría el aspecto sin que la labor esté mal.
    """
    a = np.array(Image.open(png).convert("RGB")).astype(int)
    R, G, B = a[..., 0], a[..., 1], a[..., 2]
    rojo = (R > 150) & (G < 110) & (B < 110)
    m = (a.mean(2) < 170) & ~rojo
    m = ndi.binary_fill_holes(ndi.binary_closing(m, np.ones((9, 9))))
    lb, n = ndi.label(m, np.ones((3, 3)))
    if not n:
        return None
    sz = ndi.sum(np.ones_like(lb), lb, index=range(1, n + 1))
    ys, xs = np.where(lb == int(np.argmax(sz)) + 1)
    w, h = int(xs.max() - xs.min()), int(ys.max() - ys.min())
    return dict(w=w, h=h, asp=w / max(h, 1))


def pt_proyectado(px_fuente: int, ancho_lienzo: int) -> float:
    """§11: el hueco de imagen mide 6 pulgadas de ancho en la lámina."""
    return 6 * px_fuente / ancho_lienzo * 72


def glifo_minimo(png: Path):
    """Mide el GLIFO MÁS PEQUEÑO del dibujo y lo pasa a pt proyectados.

    POR QUÉ SE MIDE Y NO SE SUPONE
        La primera versión de este script imprimía «rótulo de 52 px → 14,6 pt»
        dando por hecho que el modelo había obedecido. No lo había hecho: las
        cotas salieron de 35 px, o sea 9,8 pt. A tamaño completo la imagen se
        ve perfecta —es justo la trampa que describe el §11— y el ojo la da por
        buena. El número no.

    NO se mide el componente más pequeño: el punto decimal de «2.90» mide 8 px
    aunque los dígitos midan 35, y medirlo a él daba 5,6 pt en una imagen cuyo
    texto medía 9,8. Se miden PALABRAS: se unen los glifos vecinos dilatando en
    horizontal y se toma la MEDIANA de la altura de los bloques resultantes.
    Los filtros dejan fuera las líneas de cota, las flechas, el contorno de la
    labor y el círculo de la manga.
    """
    a = np.array(Image.open(png).convert("RGB")).astype(int)
    W = a.shape[1]
    R, G, B = a[..., 0], a[..., 1], a[..., 2]
    rojo = (R > 130) & (G < 120) & (B < 120)
    tinta = rojo | (a.mean(2) < 130)
    palabras = ndi.binary_dilation(tinta, np.ones((3, 15)))
    lb, n = ndi.label(palabras, np.ones((3, 3)))
    altos = []
    for sl in ndi.find_objects(lb):
        h, w = sl[0].stop - sl[0].start, sl[1].stop - sl[1].start
        if 16 <= h <= 130 and 0.4 <= w / h <= 12:
            altos.append(h)
    if not altos:
        return None
    altos.sort()
    px = altos[len(altos) // 2]
    return dict(px=px, pt=pt_proyectado(px, W), n=len(altos))


def revisar(d, g, control, tol=TOLERANCIA, sin_texto=False):
    """Las DOS condiciones. Pasar una sola no basta: el aspecto dice que la
    geometría es fiel, el pt dice que se lee. Una figura fiel e ilegible no
    entra a la lámina, y una legible deformada tampoco."""
    fallas = []
    if d is None:
        return False, ["no se encontró qué medir en la imagen"], 1.0
    err = abs(d["asp"] - control) / control
    if err > tol:
        fallas.append("aspecto %.3f vs control %.3f (desvío %.0f %%)"
                      % (d["asp"], control, err * 100))
    if sin_texto:
        # Los paneles de la lamina 13 van EXPRESAMENTE sin texto: el rotulo lo
        # pone unir_formas_cuerpo.py, fuera del dibujo. Pedirle letra legible a
        # una imagen que no debe llevar letra hacia fallar los tres intentos por
        # una condicion que el panel cumple al no cumplirla.
        pass
    elif g is None:
        fallas.append("no se encontró texto que medir")
    elif g["pt"] < PT_MINIMO:
        fallas.append("glifo %d px = %.1f pt proyectados, bajo el piso de %.0f"
                      % (g["px"], g["pt"], PT_MINIMO))
    return (not fallas), fallas, err


# ── generación ─────────────────────────────────────────────────────────────
def generar(ref: Path, prompt: str, tam: str, calidad: str) -> bytes:
    with open(ref, "rb") as fh:
        r = cliente().images.edit(model=MODELO_IMAGEN, image=[fh], prompt=prompt,
                                  size=tam, quality=calidad)
    return base64.b64decode(r.data[0].b64_json)


def una_figura(nombre: str, intentos=INTENTOS, calidad="high") -> int:
    cfg = FIGURAS[nombre]
    ref = RAIZ / cfg["referencia"]
    sal = RAIZ / cfg["salida"]
    if not ref.exists():
        print("falta la referencia:", ref)
        return 1

    medir = angulo_veta if cfg.get("medida") == "veta" else contorno_labor
    unidad = "grados" if cfg.get("medida") == "veta" else ""
    base, gbase = medir(ref), glifo_minimo(ref)
    print("REFERENCIA  %s" % ref.name)
    print("  medida de la fuente: %.3f %s" % (base["asp"], unidad))
    print("  control %.3f  (%s)" % (cfg["control"], cfg["origen"]))
    if gbase:
        print("  su texto: glifo %d px = %.1f pt proyectados  <- por esto no se puede usar tal cual"
              % (gbase["px"], gbase["pt"]))
    print("  tolerancia %.0f %%  ·  piso %.0f pt  ·  intentos %d\n"
          % (TOLERANCIA * 100, PT_MINIMO, intentos))

    plantilla = {"veta": PROMPT_VETA, "formas": PROMPT_FORMAS,
                 "panel": PROMPT_PANEL}.get(cfg.get("prompt") or cfg.get("medida"), PROMPT)
    sin_texto = cfg.get("prompt") == "panel"
    prompt = (plantilla.format(conservar=cfg["conservar"], color=cfg["color"])
              if cfg.get("prompt") == "panel" else
              plantilla.format(conservar=cfg["conservar"]))
    taller = ref.parent / "_crudos"
    taller.mkdir(parents=True, exist_ok=True)

    mejor = None
    for i in range(1, intentos + 1):
        crudo = taller / ("%s_intento%d.png" % (nombre, i))
        crudo.write_bytes(generar(ref, prompt, cfg["tam"], calidad))
        d, g = medir(crudo), glifo_minimo(crudo)
        ok, fallas, err = revisar(d, g, cfg["control"], sin_texto=sin_texto)
        print("  intento %d  %-8s aspecto %.3f  ·  glifo %.1f pt   %s"
              % (i, "PASA" if ok else "no pasa",
                 d["asp"] if d else 0, g["pt"] if g else 0, "; ".join(fallas)))
        if mejor is None or err < mejor[0]:
            mejor = (err, crudo, d, g, ok)
        if ok:
            mejor = (err, crudo, d, g, ok)
            break

    err, crudo, d, g, ok = mejor
    im = Image.open(crudo).convert("RGB")
    sal.parent.mkdir(parents=True, exist_ok=True)
    im.save(sal)
    print("\nENTREGABLE  %s" % sal.relative_to(RAIZ.parent))
    print("  lienzo %d x %d px" % (im.width, im.height))
    print("  aspecto %.3f contra control %.3f  (desvío %.1f %%)"
          % (d["asp"], cfg["control"], err * 100))
    print("  glifo más pequeño %d px  ->  %.1f pt proyectados (piso %.0f)"
          % (g["px"], g["pt"], PT_MINIMO) if g else "  sin texto medible")
    if ok:
        print("  VERIFICADA: pasa las dos condiciones.")
        return 0
    print("  NO PASÓ en %d intentos. Se entrega el mejor y SE DECLARA." % intentos)
    return 2


if __name__ == "__main__":
    p = argparse.ArgumentParser()
    p.add_argument("figura", choices=sorted(FIGURAS))
    p.add_argument("--intentos", type=int, default=INTENTOS)
    p.add_argument("--calidad", default="high", choices=["low", "medium", "high"])
    a = p.parse_args()
    sys.exit(una_figura(a.figura, a.intentos, a.calidad))
